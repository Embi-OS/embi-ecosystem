set(CPACK_CMAKE_GENERATOR [==[@CMAKE_GENERATOR@]==])
set(CPACK_GENERATOR "IFW")
set(CPACK_PACKAGE_NAME [==[@PACKAGECONFIG_PACKAGE_NAME@]==])
set(CPACK_PACKAGE_VENDOR [==[@PACKAGECONFIG_PACKAGE_VENDOR@]==])
set(CPACK_PACKAGE_VERSION [==[@PACKAGECONFIG_PACKAGE_VERSION@]==])
set(CPACK_PACKAGE_DESCRIPTION [==[@PACKAGECONFIG_PACKAGE_DESCRIPTION@]==])
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY [==[@PACKAGECONFIG_PACKAGE_DESCRIPTION@]==])
set(CPACK_PACKAGE_DIRECTORY [==[@PACKAGECONFIG_PACKAGE_DIRECTORY@]==])
set(CPACK_PACKAGE_FILE_NAME [==[@PACKAGECONFIG_PACKAGE_FILE_NAME@]==])
set(CPACK_PACKAGE_INSTALL_DIRECTORY [==[@PACKAGECONFIG_PACKAGE_INSTALL_DIRECTORY@]==])
set(CPACK_PACKAGE_INSTALL_REGISTRY_KEY [==[@PACKAGECONFIG_PACKAGE_NAME@]==])
set(CPACK_COMPONENTS_ALL [==[@PACKAGECONFIG_COMPONENT@]==])
set(CPACK_COMPONENT_UNSPECIFIED_HIDDEN TRUE)
set(CPACK_COMPONENT_UNSPECIFIED_REQUIRED TRUE)
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)
set(CPACK_MONOLITHIC_INSTALL TRUE)
set(CPACK_SET_DESTDIR OFF)
set(CPACK_INSTALL_CMAKE_PROJECTS [==[@PACKAGECONFIG_INSTALL_CMAKE_PROJECTS@]==])
set(CPACK_PACKAGING_INSTALL_PREFIX "/")
set(CPACK_VERBATIM_VARIABLES TRUE)
set(CPACK_IFW_PACKAGE_TITLE [==[@PACKAGECONFIG_PACKAGE_NAME@]==])
set(CPACK_IFW_PACKAGE_PUBLISHER [==[@PACKAGECONFIG_PACKAGE_VENDOR@]==])
set(CPACK_IFW_PACKAGE_NAME [==[@PACKAGECONFIG_PACKAGE_NAME@]==])
set(CPACK_IFW_PACKAGE_START_MENU_DIRECTORY [==[@PACKAGECONFIG_PACKAGE_NAME@]==])
set(CPACK_IFW_PACKAGE_MAINTENANCE_TOOL_NAME "MaintenanceTool")
set(CPACK_IFW_PACKAGE_ALLOW_SPACE_IN_PATH TRUE)
set(CPACK_IFW_BINARYCREATOR_EXECUTABLE [==[@PACKAGECONFIG_IFW_BINARYCREATOR_EXECUTABLE@]==])
set(CPACK_IFW_INSTALLERBASE_EXECUTABLE [==[@PACKAGECONFIG_IFW_INSTALLERBASE_EXECUTABLE@]==])
if(NOT [==[@PACKAGECONFIG_IFW_REPOGEN_EXECUTABLE@]==] STREQUAL "")
    set(CPACK_IFW_REPOGEN_EXECUTABLE [==[@PACKAGECONFIG_IFW_REPOGEN_EXECUTABLE@]==])
endif()
if(NOT [==[@PACKAGECONFIG_IFW_ARCHIVEGEN_EXECUTABLE@]==] STREQUAL "")
    set(CPACK_IFW_ARCHIVEGEN_EXECUTABLE [==[@PACKAGECONFIG_IFW_ARCHIVEGEN_EXECUTABLE@]==])
endif()
if(NOT [==[@PACKAGECONFIG_IFW_DEVTOOL_EXECUTABLE@]==] STREQUAL "")
    set(CPACK_IFW_DEVTOOL_EXECUTABLE [==[@PACKAGECONFIG_IFW_DEVTOOL_EXECUTABLE@]==])
endif()
if(NOT [==[@PACKAGECONFIG_IFW_ROOT@]==] STREQUAL "")
    set(CPACK_IFW_ROOT [==[@PACKAGECONFIG_IFW_ROOT@]==])
endif()
if(NOT [==[@PACKAGECONFIG_QTIFWDIR@]==] STREQUAL "")
    set(ENV{QTIFWDIR} [==[@PACKAGECONFIG_QTIFWDIR@]==])
endif()
